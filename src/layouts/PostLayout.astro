---
import { url } from '@/lib/url';
import type { MarkdownHeading } from 'astro';
import FormattedDate from '@/components/FormattedDate.astro';
import ThemeImage from '@/components/ThemeImage.astro';
import { readingTime, slugify, type Post, type Project } from '@/lib/content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  prev?: Post;
  next?: Post;
  /** Projects this post links to with `projects: [...]`. */
  projects?: Project[];
}

const { post, headings, prev, next, projects = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, coverDark, coverAlt } = post.data;
// h2/h3 only; `footnote-label` is the hidden heading Markdown adds above footnotes.
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
---

<BaseLayout title={title} description={description} image={cover} card={`blog/${post.id}`} type="article">
  <article class="container post" data-pagefind-body data-pagefind-meta="type:Post">
    <header class="post-head">
      <p class="eyebrow">
        <FormattedDate date={pubDate} /> · {readingTime(post.body)}
        {
          updatedDate && (
            <>
              {' '}
              · updated <FormattedDate date={updatedDate} />
            </>
          )
        }
      </p>
      <h1 data-pagefind-meta="title">{title}</h1>
      <p class="lede">{description}</p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((t) => (
              <li>
                <a class="tag" href={url(`/tags/${slugify(t)}/`)}>
                  #{t}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <div class="cover">
          <ThemeImage light={cover} dark={coverDark} alt={coverAlt} loading="eager" widths={[720, 1200, 1600]} sizes="(max-width: 72rem) 100vw, 1100px" />
        </div>
      )
    }

    <div class:list={['post-body', { 'has-toc': toc.length > 2 }]}>
      {
        toc.length > 2 && (
          <aside class="toc" aria-label="Table of contents" data-pagefind-ignore>
            <p class="eyebrow">On this page</p>
            <ol>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
      <div class="prose">
        <slot />
      </div>
    </div>

    {
      projects.length > 0 && (
        <aside class="related" aria-label={projects.length === 1 ? 'Related project' : 'Related projects'} data-pagefind-ignore>
          <p class="eyebrow">{projects.length === 1 ? 'Project' : 'Projects'}</p>
          <ul>
            {projects.map((p) => (
              <li>
                <a href={url(`/projects/${p.id}/`)} class="card">
                  <strong>{p.data.title}</strong>
                  <span class="muted">{p.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    {
      (prev || next) && (
        <nav class="pager" aria-label="More posts" data-pagefind-ignore>
          {prev ? (
            <a href={url(`/blog/${prev.id}/`)} class="card">
              <span class="muted">← Older</span>
              {prev.data.title}
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={url(`/blog/${next.id}/`)} class="card next">
              <span class="muted">Newer →</span>
              {next.data.title}
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<script>
  // Highlight the section being read in "On this page".
  const toc = document.querySelector<HTMLElement>('.toc');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const sections = links
    .map((link) => ({ link, heading: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
    .filter((s): s is { link: HTMLAnchorElement; heading: HTMLElement } => s.heading !== null);

  let current: HTMLAnchorElement | undefined;

  function update() {
    // A heading counts as "reached" once it scrolls under the sticky header (plus a little slack).
    const line = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 80;
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    const reached = sections.filter((s) => s.heading.getBoundingClientRect().top <= line + 1);
    // At the very bottom the last sections may never reach the line; highlight the last one.
    const active = atBottom ? sections.at(-1) : reached.at(-1);

    if (active?.link === current) return;
    current?.removeAttribute('aria-current');
    current = active?.link;
    if (!current || !toc) return;
    current.setAttribute('aria-current', 'true');

    // Keep the item visible when the list scrolls (without scrolling the page).
    const item = current.getBoundingClientRect();
    const box = toc.getBoundingClientRect();
    if (item.top < box.top) toc.scrollTop -= box.top - item.top + 8;
    else if (item.bottom > box.bottom) toc.scrollTop += item.bottom - box.bottom + 8;
  }

  if (sections.length) {
    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>

<style>
  .post-head {
    max-width: var(--prose-w);
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 2rem;
  }

  .lede {
    font-size: 1.2rem;
    color: var(--text-muted);
  }

  .cover {
    margin-bottom: 2.5rem;
  }

  .cover :global(img) {
    width: 100%;
    max-height: 32rem;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .post-body.has-toc {
    display: grid;
    grid-template-columns: minmax(0, var(--prose-w)) 14rem;
    justify-content: space-between;
    gap: 3rem;
  }

  .toc {
    order: 2;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    align-self: start;
    /* Long tables of contents scroll on their own (the script keeps the current item in view) */
    max-height: calc(100dvh - var(--header-h) - 4rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-left: 2px; /* room for the current-section bar */
    font-size: 0.9rem;
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.9rem;
    border-left: 1px solid var(--border);
  }

  .toc li {
    position: relative;
    margin-bottom: 0.45rem;
  }

  .toc .d3 {
    padding-left: 0.9rem;
  }

  .toc a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--accent-text);
  }

  /* Current section, set by the script below */
  .toc a[aria-current='true'] {
    color: var(--accent-text);
    font-weight: 500;
  }

  .toc li:has(> a[aria-current='true'])::before {
    content: '';
    position: absolute;
    left: calc(-0.9rem - 1.5px);
    top: 0.15em;
    bottom: 0.15em;
    width: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  @media (max-width: 64rem) {
    .post-body.has-toc {
      display: block;
    }

    .toc {
      display: none;
    }
  }

  .related {
    max-width: var(--prose-w);
    margin-top: 3.5rem;
  }

  .related ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 2.75rem 1rem 1.25rem;
    color: var(--text);
    text-decoration: none;
  }

  .related a::after {
    content: '→';
    position: absolute;
    right: 1.25rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--text-muted);
  }

  .related a:hover {
    border-color: var(--accent);
  }

  .related a:hover::after {
    color: var(--accent-text);
  }

  .related span {
    font-size: 0.95rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    max-width: var(--prose-w);
    margin-top: 4rem;
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.25rem;
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }

  .pager a:hover {
    border-color: var(--accent);
  }

  .pager .next {
    text-align: right;
    grid-column: 2;
  }

  .pager span {
    font-size: 0.85rem;
    font-weight: 400;
  }

  @media (max-width: 40rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      grid-column: 1;
    }
  }
</style>
