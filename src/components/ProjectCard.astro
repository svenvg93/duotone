---
import { url } from '@/lib/url';
import type { Project } from '@/lib/content';
import ThemeImage from './ThemeImage.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, cover, coverDark, coverAlt, stack, period, date, status } = project.data;
---

<article class="card project-card" data-stack={stack.join('|')}>
  {
    cover && (
      <div class="media">
        <ThemeImage light={cover} dark={coverDark} alt={coverAlt} widths={[400, 800]} sizes="(max-width: 40rem) 100vw, 400px" />
      </div>
    )
  }
  <div class="body">
    <p class="meta">
      <span>{period ?? date.getFullYear()}</span>
      {status && <span class={`status status--${status}`}>{status}</span>}
    </p>
    <h3><a href={url(`/projects/${project.id}/`)}>{title}</a></h3>
    <p class="desc">{description}</p>
    {
      stack.length > 0 && (
        <ul class="tags">
          {stack.slice(0, 5).map((s) => (
            <li class="tag">{s}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .project-card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    box-shadow: var(--shadow);
  }

  .media {
    aspect-ratio: 16 / 9;
    background: var(--bg-muted);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-card:hover .media :global(img) {
    transform: scale(1.02);
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.1rem 1.25rem 1.25rem;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  /* Whole card is clickable via the title link */
  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    flex: 1;
  }

  .status {
    text-transform: capitalize;
  }

  .status::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    margin-right: 0.4rem;
    background: currentColor;
    vertical-align: 0.05em;
  }

  .status--active {
    color: var(--status-active);
  }

  .status--maintained {
    color: var(--accent-text);
  }
</style>
