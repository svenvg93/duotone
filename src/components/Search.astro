---
/**
 * Site search, powered by Pagefind (https://pagefind.app).
 *
 * `npm run build` runs `pagefind --site dist` after `astro build`, which indexes
 * every element marked `data-pagefind-body` (posts and projects) into
 * dist/pagefind/. This component loads that index on first open, so search adds
 * nothing to the page weight until it's used. In `astro dev` there is no index;
 * the dialog says so. Open with the header button, ⌘K / Ctrl+K, or "/".
 */
import Icon from './Icon.astro';
---

<button class="search-btn" type="button" aria-label="Search" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K /">
  <Icon name="search" size={18} />
  <span class="search-label">Search</span>
  <kbd class="search-kbd">⌘K</kbd>
</button>

<dialog class="search-dialog" aria-label="Search">
  <div class="search-box">
    <Icon name="search" size={18} />
    <input
      type="search"
      placeholder="Search posts and projects"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
    />
    <button class="search-close" type="button" aria-label="Close search">Esc</button>
  </div>
  <p class="search-status" role="status"></p>
  <ul id="search-results" class="search-results" role="listbox" aria-label="Results"></ul>
</dialog>

<style>
  .search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding: 0 0.5rem 0 0.65rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elev);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .search-btn:hover {
    color: var(--text);
    border-color: var(--text-muted);
  }

  .search-label {
    margin-right: 1.25rem;
  }

  kbd {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    background: var(--bg-muted);
    font: 500 0.7rem var(--font-mono);
  }

  /* Phones: icon-only button, no keyboard hint */
  @media (max-width: 40rem) {
    .search-btn {
      width: 2.25rem;
      padding: 0;
      justify-content: center;
      border-color: transparent;
      background: none;
    }

    .search-label,
    .search-kbd {
      display: none;
    }
  }

  .search-dialog {
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100dvh - 6rem));
    margin: 4.5rem auto auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    color: var(--text);
    box-shadow: var(--shadow), 0 24px 64px -16px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  .search-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  .search-dialog::backdrop {
    background: rgb(0 0 0 / 0.35);
    backdrop-filter: blur(2px);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
  }

  input {
    flex: 1;
    min-width: 0;
    height: 3.25rem;
    border: 0;
    outline: 0;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 1.05rem;
  }

  input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    background: var(--bg-muted);
    color: var(--text-muted);
    font: 500 0.7rem var(--font-mono);
    cursor: pointer;
  }

  .search-status {
    margin: 0;
    padding: 0.75rem 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .search-status:empty {
    display: none;
  }

  .search-results {
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    overflow-y: auto;
  }

  .search-results:empty {
    display: none;
  }

  .search-results :global(a) {
    display: block;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--text);
    text-decoration: none;
  }

  .search-results :global([aria-selected='true'] a) {
    background: var(--accent-soft);
  }

  .search-results :global(.r-head) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 600;
  }

  .search-results :global(.r-type) {
    flex: none;
    color: var(--text-muted);
    font: 500 0.75rem var(--font-mono);
  }

  .search-results :global(.r-excerpt) {
    display: block;
    margin-top: 0.2rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .search-results :global(.r-section) {
    display: block;
    margin-top: 0.15rem;
    color: var(--accent-text);
    font-size: 0.85rem;
  }

  .search-results :global(mark) {
    background: none;
    color: var(--accent-text);
    font-weight: 600;
  }
</style>

<script>
  type Pagefind = {
    options(o: Record<string, unknown>): Promise<void>;
    debouncedSearch(q: string, opts?: object, ms?: number): Promise<{ results: { data(): Promise<Result> }[] } | null>;
  };
  type Result = {
    url: string;
    excerpt: string;
    meta: { title?: string; type?: string };
    sub_results?: { title: string; url: string; excerpt: string; locations: number[] }[];
  };

  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const btn = document.querySelector<HTMLButtonElement>('.search-btn')!;
  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')!;
  const input = dialog.querySelector('input')!;
  const status = dialog.querySelector<HTMLElement>('.search-status')!;
  const list = dialog.querySelector<HTMLUListElement>('.search-results')!;

  // On Windows/Linux show Ctrl K instead of ⌘K.
  if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
    const kbd = btn.querySelector('kbd');
    if (kbd) kbd.textContent = 'Ctrl K';
  }

  let pagefind: Pagefind | null | undefined;
  let active = -1;

  async function load(): Promise<Pagefind | null> {
    if (pagefind !== undefined) return pagefind;
    try {
      // Built by `pagefind --site dist`; absent in `astro dev`.
      const pagefindUrl = `${base}pagefind/pagefind.js`;
      pagefind = (await import(/* @vite-ignore */ pagefindUrl)) as Pagefind;
      await pagefind.options({ baseUrl: base, excerptLength: 18 });
    } catch {
      pagefind = null;
    }
    return pagefind;
  }

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    load().then((pf) => {
      if (!pf) status.textContent = 'Search is available in the built site (npm run build && npm run preview).';
    });
  }

  function select(index: number) {
    const items = [...list.children] as HTMLElement[];
    if (!items.length) return;
    active = (index + items.length) % items.length;
    items.forEach((li, i) => li.setAttribute('aria-selected', String(i === active)));
    const current = items[active];
    input.setAttribute('aria-activedescendant', current.id);
    current.scrollIntoView({ block: 'nearest' });
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  }

  async function search(query: string) {
    const pf = await load();
    if (!pf) return;
    const q = query.trim();
    if (!q) {
      list.replaceChildren();
      status.textContent = '';
      input.setAttribute('aria-expanded', 'false');
      return;
    }

    const res = await pf.debouncedSearch(q, {}, 150);
    if (!res) return; // superseded by a newer keystroke
    const results = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));

    active = -1;
    input.removeAttribute('aria-activedescendant');
    input.setAttribute('aria-expanded', String(results.length > 0));
    status.textContent = results.length ? '' : `No results for “${q}”.`;

    // Pagefind excerpts are already HTML-escaped, with matches wrapped in <mark>.
    list.innerHTML = results
      .map((r, i) => {
        // Link to the section with the most matches, when that's a heading (not the page intro).
        const best = r.sub_results?.toSorted((a, b) => b.locations.length - a.locations.length)[0];
        const sub = best?.url.includes('#') ? best : undefined;
        return `<li id="search-result-${i}" role="option" aria-selected="false">
          <a href="${sub?.url ?? r.url}">
            <span class="r-head"><span>${escapeHtml(r.meta.title ?? r.url)}</span>${r.meta.type ? `<span class="r-type">${escapeHtml(r.meta.type)}</span>` : ''}</span>
            ${sub ? `<span class="r-section">§ ${escapeHtml(sub.title)}</span>` : ''}
            <span class="r-excerpt">${sub?.excerpt ?? r.excerpt}</span>
          </a>
        </li>`;
      })
      .join('');
    if (results.length) select(0);
  }

  btn.addEventListener('click', open);
  input.addEventListener('input', () => search(input.value));

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      // A search input would otherwise swallow Esc to clear itself.
      e.preventDefault();
      dialog.close();
    } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      select(active + (e.key === 'ArrowDown' ? 1 : -1));
    } else if (e.key === 'Enter' && active >= 0) {
      e.preventDefault();
      list.children[active]?.querySelector('a')?.click();
    }
  });

  list.addEventListener('mousemove', (e) => {
    const li = (e.target as HTMLElement).closest('li');
    if (li) select([...list.children].indexOf(li));
  });

  // Close on link click (same-page #anchors wouldn't navigate away), the Esc button, or the backdrop.
  list.addEventListener('click', (e) => (e.target as HTMLElement).closest('a') && dialog.close());
  dialog.querySelector('.search-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());

  document.addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea, select, [contenteditable]');
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      dialog.open ? dialog.close() : open();
    }
  });
</script>
