---
import BlogIndex from '@/components/BlogIndex.astro';
import { getPosts, paginatePosts } from '@/lib/content';

// Page 1 of the blog; later pages are /blog/page/[page]/ (see SITE.postsPerPage).
const posts = await getPosts();
const pages = paginatePosts(posts);
---

<BlogIndex posts={pages[0]} allPosts={posts} page={1} totalPages={pages.length} />
