---
import { render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import { getPosts, type Post } from '@/lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Posts are sorted newest first, so "next" (newer) is the previous index.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, next: posts[i - 1], prev: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} prev={prev} next={next}>
  <Content />
</PostLayout>
