---
import { url } from '@/lib/url';
import Icon from '@/components/Icon.astro';
import PostList from '@/components/PostList.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ThemeImage from '@/components/ThemeImage.astro';
import { HOME, SOCIALS } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, getProjects } from '@/lib/content';

// All text and sections come from HOME in src/config.ts.
const posts = await getPosts();
const allProjects = await getProjects();
const featured = allProjects.filter((p) => p.data.featured);
const projects = featured.length ? featured : allProjects;
const socials = HOME.showSocials ? SOCIALS.filter((s) => s.icon !== 'rss') : [];
---

<BaseLayout>
  <section class="container hero">
    <div class="intro">
      {HOME.eyebrow && <p class="eyebrow">{HOME.eyebrow}</p>}
      <h1>{HOME.headline}</h1>
      {HOME.intro && <p class="lede">{HOME.intro}</p>}
      {
        (HOME.actions.length > 0 || socials.length > 0) && (
          <div class="cta">
            {HOME.actions.map((a) => (
              <a href={url(a.href)} class:list={['btn', { 'btn--primary': a.primary }]}>
                {a.label}
              </a>
            ))}
            {socials.length > 0 && (
              <ul class="socials">
                {socials.map((s) => (
                  <li>
                    <a href={url(s.href)} aria-label={s.label} title={s.label} rel="me noopener">
                      <Icon name={s.icon} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }
    </div>
    {
      HOME.avatar && (
        <div class="portrait">
          <ThemeImage light={HOME.avatar.light} dark={HOME.avatar.dark} alt={HOME.avatar.alt} loading="eager" width={320} height={320} />
        </div>
      )
    }
  </section>

  {
    HOME.sections.map((section) =>
      section.type === 'posts'
        ? posts.length > 0 && (
            <section class="container section">
              <div class="section-head">
                <h2>{section.title}</h2>
                <a href={url('/blog/')} class="link-arrow">
                  {section.linkLabel}
                </a>
              </div>
              <PostList posts={posts.slice(0, section.count)} />
            </section>
          )
        : projects.length > 0 && (
            <section class="container section">
              <div class="section-head">
                <h2>{section.title}</h2>
                <a href={url('/projects/')} class="link-arrow">
                  {section.linkLabel}
                </a>
              </div>
              <div class="grid">
                {projects.slice(0, section.count).map((p) => (
                  <ProjectCard project={p} />
                ))}
              </div>
            </section>
          ),
    )
  }
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 3rem;
    padding-block: clamp(3rem, 10vw, 7rem) clamp(1rem, 4vw, 2rem);
  }

  h1 {
    max-width: 20ch;
  }

  .lede {
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem);
    color: var(--text-muted);
    max-width: 38rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .socials {
    display: flex;
    gap: 0.25rem;
    margin: 0 0 0 0.5rem;
    padding: 0;
    list-style: none;
  }

  .socials a {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }

  .socials a:hover {
    color: var(--text);
    background: var(--bg-muted);
  }

  .portrait :global(img) {
    width: clamp(10rem, 22vw, 18rem);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  @media (max-width: 48rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .portrait {
      order: -1;
    }

    .portrait :global(img) {
      width: 7rem;
    }

    .socials {
      margin-left: 0;
    }
  }
</style>
